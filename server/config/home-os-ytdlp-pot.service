[Unit]
Description=Home OS YouTube proof-of-origin token provider
After=network-online.target
Wants=network-online.target
Before=home-os.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/home-os/vendor/bgutil-ytdlp-pot-provider-current/server
ExecStart=/usr/bin/node build/main.js --port 4416
Restart=on-failure
RestartSec=3
Environment=HOME=/var/cache/home-os-ytdlp-pot
CacheDirectory=home-os-ytdlp-pot
CacheDirectoryMode=0700
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
